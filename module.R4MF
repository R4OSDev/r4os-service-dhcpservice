R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=DHCPSVC
VERSION=0.1.9
LANGUAGE=Zig
SDK_PROFILE=r4os-zig-generation2
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/DHCPSVC.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query2:2
